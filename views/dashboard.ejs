<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MarmitaTech - Dashboard</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="/js/dashboard.js" defer></script>
</head>
<body>
    <div class="page-shell">
        <header class="topline">
            <div>
                <h1>Painel Administrativo - MarmitaTech</h1>
                <p>Gerencie o fluxo de produção da cozinha em tempo real.</p>
            </div>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error" role="alert" aria-live="polite"><%= error %></div>
        <% } %>

        <main aria-label="Painel administrativo">
            <div class="grid">
                <section class="card" aria-label="Nova marmita">
                    <h3>Nova Marmita</h3>
                    <form action="/add-item" method="POST">
                        <input type="text" name="name" placeholder="Nome da marmita" aria-label="Nome da marmita" required>
                        <input type="number" name="price" placeholder="Preço" step="0.01" min="0.01" aria-label="Preço da marmita" required>
                        <input type="text" name="category" placeholder="Categoria (opcional)" aria-label="Categoria da marmita">
                        <button type="submit">Cadastrar Marmita</button>
                    </form>
                </section>

                <section class="card" aria-label="Novo pedido">
                    <h3>Novo Pedido</h3>
                    <% if (items.length === 0) { %>
                        <p>Cadastre uma marmita antes de registrar pedidos.</p>
                    <% } else { %>
                        <form action="/orders" method="POST">
                            <input type="text" name="customer_name" placeholder="Nome do cliente" aria-label="Nome do cliente" required>
                            <select name="item_id" aria-label="Selecione a marmita" required>
                                <option value="">Selecione a marmita</option>
                                <% items.forEach(item => { %>
                                    <option value="<%= item.id %>"><%= item.name %> - R$ <%= Number(item.price).toFixed(2) %></option>
                                <% }) %>
                            </select>
                            <button type="submit">Registrar Pedido</button>
                        </form>
                    <% } %>
                </section>

                <section class="card" aria-label="Itens cadastrados">
                    <h3>Itens Cadastrados</h3>
                    <% if (items.length === 0) { %>
                        <p class="helper">Nenhuma marmita cadastrada.</p>
                    <% } else { %>
                        <div class="items-list">
                            <% items.forEach(item => { %>
                                <div class="item-row">
                                    <div class="item-info">
                                        <strong><%= item.name %></strong>
                                        <span class="item-details">R$ <%= Number(item.price).toFixed(2) %> • <%= item.category || 'Sem categoria' %></span>
                                    </div>
                                    <div class="item-actions">
                                        <button class="item-edit-btn" type="button" data-item-id="<%= item.id %>" data-item-name="<%= item.name %>" data-item-price="<%= item.price %>" data-item-category="<%= item.category || '' %>">✏️ Editar</button>
                                        <form action="/items/<%= item.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Tem certeza que deseja deletar este item?');">
                                            <button type="submit" class="item-delete-btn">🗑️ Deletar</button>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </section>

                <section class="card" aria-label="Relatórios">
                    <h3>Relatórios</h3>
                    <p>Exporte o histórico de vendas para controle financeiro.</p>
                    <a href="/admin/export" class="download-button" download>
                        📊 Baixar Relatório (CSV)
                    </a>
                </section>
            </div>

            <h2>Fluxo de produção</h2>
            <section class="board" aria-label="Quadro de pedidos por status">
                <% ['Aberto', 'Cozinha', 'Entrega', 'Entregue'].forEach(status => { %>
                    <section class="column" aria-label="<%= status %>">
                        <div class="column-header">
                            <h3><%= status %></h3>
                            <span class="badge"><%= (ordersByStatus && ordersByStatus[status] ? ordersByStatus[status].length : 0) %></span>
                        </div>

                        <% const columnOrders = ordersByStatus && ordersByStatus[status] ? ordersByStatus[status] : []; %>
                        <% if (columnOrders.length === 0) { %>
                            <div class="empty-state">Sem pedidos nesta etapa.</div>
                        <% } else { %>
                            <div class="column-list">
                                <% columnOrders.forEach(order => { %>
                                    <article class="order-card">
                                        <strong><%= order.customer_name %></strong>
                                        <p class="order-meta">
                                            <%= order.item_name || 'Marmita removida' %> -
                                            <%= order.item_price != null ? `R$ ${Number(order.item_price).toFixed(2)}` : 'Preço indisponível' %>
                                        </p>
                                        <span class="order-status"><%= order.status %></span>
                                        <% if (order.status !== 'Entregue') { %>
                                            <form class="order-action" action="/orders/<%= order.id %>/advance" method="POST" data-advance-form>
                                                <button type="submit" class="secondary-button" data-advance-button>Avançar status</button>
                                            </form>
                                        <% } else { %>
                                            <p class="helper">Pedido concluído.</p>
                                        <% } %>
                                    </article>
                                <% }) %>
                            </div>
                        <% } %>
                    </section>
                <% }) %>
            </section>
        </main>

        <!-- Modal de Edição de Item -->
        <div id="editModal" class="modal" role="dialog" aria-labelledby="editModalTitle" aria-hidden="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 id="editModalTitle">Editar Marmita</h2>
                    <button type="button" class="modal-close" data-close-modal>&times;</button>
                </div>
                <form id="editForm" method="POST">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="editName">Nome da marmita</label>
                            <input type="text" id="editName" name="name" placeholder="Nome da marmita" required>
                        </div>
                        <div class="form-group">
                            <label for="editPrice">Preço</label>
                            <input type="number" id="editPrice" name="price" placeholder="Preço" step="0.01" min="0.01" required>
                        </div>
                        <div class="form-group">
                            <label for="editCategory">Categoria (opcional)</label>
                            <input type="text" id="editCategory" name="category" placeholder="Categoria (opcional)">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="secondary-button" data-close-modal>Cancelar</button>
                        <button type="submit" class="primary-button">Salvar Alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        const modal = document.getElementById('editModal');
        const editForm = document.getElementById('editForm');
        const editButtons = document.querySelectorAll('.item-edit-btn');
        const closeButtons = document.querySelectorAll('[data-close-modal]');

        editButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const itemId = btn.dataset.itemId;
                const itemName = btn.dataset.itemName;
                const itemPrice = btn.dataset.itemPrice;
                const itemCategory = btn.dataset.itemCategory;

                document.getElementById('editName').value = itemName;
                document.getElementById('editPrice').value = itemPrice;
                document.getElementById('editCategory').value = itemCategory;
                editForm.action = `/items/${itemId}/edit`;

                modal.setAttribute('aria-hidden', 'false');
                modal.style.display = 'block';
                document.body.style.overflow = 'hidden';
            });
        });

        closeButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                modal.setAttribute('aria-hidden', 'true');
                modal.style.display = 'none';
                document.body.style.overflow = 'auto';
            });
        });

        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.setAttribute('aria-hidden', 'true');
                modal.style.display = 'none';
                document.body.style.overflow = 'auto';
            }
        });
    </script>
</body>
</html>
