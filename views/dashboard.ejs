<!DOCTYPE html>
<html>
<head>
    <title>MarmitaTech - Dashboard</title>
    <style>
        body { font-family: sans-serif; padding: 20px; background: #f7f7f2; color: #1f1f1f; }
        .grid { display: flex; gap: 20px; align-items: flex-start; flex-wrap: wrap; }
        .card { border: 1px solid #d9d9cf; background: #fff; padding: 15px; border-radius: 8px; width: 320px; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04); }
        .card h3 { margin-top: 0; }
        .error { margin: 0 0 16px; padding: 12px; border-radius: 6px; background: #ffe3e3; color: #8b0000; }
        .orders-list { list-style: none; padding: 0; margin: 0; }
        .orders-list li { padding: 10px 0; border-bottom: 1px solid #ecebe3; }
        .orders-list li:last-child { border-bottom: 0; }
        select, input, button { width: 100%; box-sizing: border-box; }
    </style>
</head>
<body>
    <h1>Painel Administrativo - MarmitaTech</h1>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="error"><%= error %></div>
    <% } %>
    <div class="grid">
        <div class="card">
            <h3>Nova Marmita</h3>
            <form action="/add-item" method="POST">
                <input type="text" name="name" placeholder="Nome da marmita" required><br><br>
                <input type="number" name="price" placeholder="Preço" step="0.01" min="0.01" required><br><br>
                <input type="text" name="category" placeholder="Categoria (opcional)"><br><br>
                <button type="submit">Cadastrar Marmita</button>
            </form>
        </div>

        <div class="card">
            <h3>Novo Pedido</h3>
            <% if (items.length === 0) { %>
                <p>Cadastre uma marmita antes de registrar pedidos.</p>
            <% } else { %>
                <form action="/orders" method="POST">
                    <input type="text" name="customer_name" placeholder="Nome do cliente" required><br><br>
                    <select name="item_id" required>
                        <option value="">Selecione a marmita</option>
                        <% items.forEach(item => { %>
                            <option value="<%= item.id %>"><%= item.name %> - R$ <%= Number(item.price).toFixed(2) %></option>
                        <% }) %>
                    </select><br><br>
                    <button type="submit">Registrar Pedido</button>
                </form>
            <% } %>
        </div>

        <div class="card">
            <h3>Itens Cadastrados</h3>
            <ul>
                <% items.forEach(item => { %>
                    <li><%= item.name %> - R$ <%= Number(item.price).toFixed(2) %> (<%= item.category || 'Sem categoria' %>)</li>
                <% }) %>
            </ul>
        </div>
    </div>

    <hr>
    <h2>📦 Pedidos Ativos</h2>
    <% if (orders.length === 0) { %>
        <p><i>Nenhum pedido cadastrado ainda.</i></p>
    <% } else { %>
        <ul class="orders-list">
            <% orders.forEach(order => { %>
                <li>
                    <strong><%= order.customer_name %></strong> pediu <%= order.item_name || 'Marmita removida' %>
                    - <%= order.item_price != null ? `R$ ${Number(order.item_price).toFixed(2)}` : 'Preço indisponível' %>
                    <br>
                    Status: <%= order.status %>
                </li>
            <% }) %>
        </ul>
    <% } %>
</body>
</html>
